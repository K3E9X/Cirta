{
  "name": "cirta-vscode",
  "displayName": "Cirta",
  "description": "What a document says about its making — metadata, hidden text, active content, invisible characters — found in the editor, locally.",
  "version": "0.2.0",
  "publisher": "k3e9x",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/K3E9X/Cirta" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters", "Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "cirta.inspect", "title": "Inspect this file", "category": "Cirta" },
      { "command": "cirta.clean", "title": "Write a cleaned copy", "category": "Cirta" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "cirta.inspect", "when": "!explorerResourceIsFolder", "group": "7_modification@1" },
        { "command": "cirta.clean", "when": "!explorerResourceIsFolder", "group": "7_modification@2" }
      ]
    },
    "configuration": {
      "title": "Cirta",
      "properties": {
        "cirta.inspectTextFiles": {
          "type": "boolean",
          "default": true,
          "description": "Inspect text files when they are opened and saved: invisible characters underlined where they are."
        }
      }
    }
  }
}
