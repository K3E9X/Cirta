{
  "name": "cirta",
  "version": "0.1.0",
  "description": "Inspect and clean what documents say about their making — metadata, hidden text, active content, invisible characters — locally, in PDF, Office, OpenDocument, images, mail, notebooks and text.",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/cli/node.d.ts",
      "default": "./dist/cli/node.js"
    },
    "./schema/report.v1.json": "./schema/report.v1.json",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "bin": {
    "cirta": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.web.json",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/smoke.mjs && node scripts/fuzz.mjs --iterations 400 && npm run build:web && node scripts/check-site.mjs",
    "fuzz": "node scripts/fuzz.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
